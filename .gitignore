# --- Copias de los datos convertidas a Excel ---------------
# No usarlas: Excel en espanol invierte las fechas con dia <= 12.
# El modelo lee solo los CSV originales de data/.
data/*.xlsx
data/*.xls

# --- Power BI ----------------------------------------------
# Si en algun momento usan el formato de proyecto (.pbip):
# configuracion local y cache de datos de cada usuario
**/.pbi/localSettings.json
**/.pbi/cache.abf

# --- Office (archivos de bloqueo mientras un documento esta abierto)
~$*

# --- Python (script de validacion) --------------------------
__pycache__/
*.pyc
.venv/
venv/

# --- Sistema operativo ----------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# --- Editores --------------------------------------------------
.vscode/
.idea/
*.swp
